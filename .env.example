# ==============================================================================
# KisanAI Environment Configuration
# ==============================================================================
# Copy this file to `.env` (either in the repository root or in the `backend/` directory)
# and replace the placeholder values with your actual configuration before running.
#
#   cp .env.example .env
#   - or -
#   cp .env.example backend/.env
#
# IMPORTANT: NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication & Security (REQUIRED)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT access tokens.
# The application will refuse to start if this variable is not set.
# Generate a cryptographically secure 32+ character random string, for example:
#   openssl rand -hex 32
SECRET_KEY=your_super_secret_jwt_key_min_32_chars_long

# ------------------------------------------------------------------------------
# 2. Database Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# SQLAlchemy database connection URL.
# If omitted, defaults to a local SQLite database at `backend/kisanai_v2.db`.
#
# SQLite example (default):
# DATABASE_URL=sqlite:///kisanai_v2.db
#
# PostgreSQL example:
# DATABASE_URL=postgresql://kisan_user:secure_password@localhost:5432/kisanai
DATABASE_URL=sqlite:///kisanai_v2.db

# ------------------------------------------------------------------------------
# 3. Weather Service - OpenWeatherMap (OPTIONAL)
# ------------------------------------------------------------------------------
# API key for OpenWeatherMap 5-day weather forecast API.
# Required for live weather data and automated risk scoring.
# Obtain a free or paid API key from: https://openweathermap.org/api
OPENWEATHER_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# 4. AI Service - OpenRouter (OPTIONAL)
# ------------------------------------------------------------------------------
# API key for OpenRouter LLM service.
# Used to synthesize structured agronomic explanations from deterministic risk scores.
# Obtain an API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model identifier to use for risk narrative generation.
# Defaults to "openrouter/auto" if unset.
# Examples:
#   - openrouter/auto
#   - meta-llama/llama-3.1-8b-instruct:free
#   - mistralai/mistral-7b-instruct:free
LLM_MODEL=openrouter/auto
